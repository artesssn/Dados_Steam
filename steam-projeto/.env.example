# Copie este arquivo para ".env". O .env NÃO vai para o GitHub (está no .gitignore).

# Banco vetorial: PostgreSQL + pgvector (sobe com: docker compose up -d)
DATABASE_URL=postgresql://steam:steam@localhost:5432/steam

# LLM do agente - OPCIONAL. Sem nada aqui, o agente funciona em modo só busca (padrão do projeto):
# mostra os trechos encontrados no pgvector. Se quiserem que um LLM local redija a resposta:
# Opção 1: Ollama. Instale em https://ollama.com e rode no terminal:
#     ollama pull qwen2.5:7b
# depois tire o # da linha abaixo
# OLLAMA=1
# OLLAMA_MODEL=qwen2.5:7b
# Notebook sem placa de vídeo ou com 8 GB de RAM? Use o modelo menor, que responde umas 2x mais rápido:
#     ollama pull qwen2.5:3b      e troque a linha acima por  OLLAMA_MODEL=qwen2.5:3b

# Opção 2 (Linux/macOS): arquivo GGUF com llama-cpp-python
# LLAMA_GGUF=/caminho/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf

# Chave da Steam Web API (https://steamcommunity.com/dev/apikey).
# Os endpoints usados no projeto NÃO exigem chave; guarde aqui caso o grupo use outro.
STEAM_API_KEY=
